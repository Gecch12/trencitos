# Local development uses file storage by default. Never commit real secrets.
STATE_BACKEND=file
# Render: select supabase and fill BOTH values in Render > Environment.
# STATE_BACKEND=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_replace_in_render_only

# Google is optional; guest play works while disabled. Use a DEV Auth project locally.
AUTH_ENABLED=false
# Enable after Discord OAuth and Manual Linking are configured in Supabase.
AUTH_DISCORD_ENABLED=false
# AUTH_BASE_URL=http://localhost:3000
# AUTH_SUPABASE_URL=https://your-auth-project.supabase.co
# AUTH_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_locally
# AUTH_COOKIE_SECRET=64_hex_characters_generated_with_openssl_rand_hex_32
# Google Client ID/secret belong in Supabase > Auth > Google, never in this repo.
